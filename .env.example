# Copy to .env.local. The chat's model runs through Vercel AI Gateway:
# create a key in the Vercel dashboard under AI Gateway > API Keys.
AI_GATEWAY_API_KEY=
# Optional. Defaults to anthropic/claude-haiku-5.5.
# Any Gateway model ID works.
AI_GATEWAY_MODEL=
# Parallel web search for the Area Chart card (and any other live research).
# https://ai-sdk.dev/resources/tools/parallel
PARALLEL_API_KEY=
